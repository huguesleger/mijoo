rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function isMember(householdId) {
      return signedIn()
        && exists(householdPath(householdId))
        && request.auth.uid in get(householdPath(householdId)).data.memberIds;
    }

    function isMemberAfterWrite(householdId) {
      return signedIn()
        && existsAfter(householdPath(householdId))
        && request.auth.uid in getAfter(householdPath(householdId)).data.memberIds;
    }

    function isWordList(value) {
      return value is list && value.size() <= 50;
    }

    function isCount(value, minimum, maximum) {
      return value is int && value >= minimum && value <= maximum;
    }

    function isLocation(location) {
      return location == null || (
        location is map
        && location.keys().hasOnly(['postalCode', 'city'])
        && location.postalCode is string
        && location.postalCode.size() <= 10
        && location.city is string
        && location.city.size() <= 100
      );
    }

    function isProfile(profile) {
      return profile == null || (
        profile is map
        && profile.keys().hasOnly([
          'adults', 'children', 'likes', 'exclusions', 'allergies',
          'maxPrepMinutes', 'weeklyBudgetCents', 'location'
        ])
        && isCount(profile.adults, 1, 12)
        && isCount(profile.children, 0, 12)
        && isWordList(profile.likes)
        && isWordList(profile.exclusions)
        && isWordList(profile.allergies)
        && isCount(profile.maxPrepMinutes, 5, 240)
        && (profile.weeklyBudgetCents == null
          || isCount(profile.weeklyBudgetCents, 0, 10000000))
        && isLocation(profile.location)
      );
    }

    function isStockItem(item) {
      return item.keys().hasOnly([
          'name', 'quantity', 'unit', 'category', 'bestBefore', 'createdAt', 'updatedAt'
        ])
        && item.name is string
        && item.name.size() >= 1
        && item.name.size() <= 80
        && item.quantity is number
        && item.quantity > 0
        && item.quantity <= 100000
        && item.unit in ['piece', 'gram', 'kilogram', 'milliliter', 'liter', 'pack']
        && item.category in [
          'fruitsVegetables', 'meatFish', 'dairy', 'grocery', 'frozen', 'drinks', 'other'
        ]
        && (item.bestBefore == null || item.bestBefore is timestamp)
        && item.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['householdId'])
        && request.resource.data.householdId is string
        && isMemberAfterWrite(request.resource.data.householdId);
      allow update, delete: if false;
    }

    match /households/{householdId} {
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.memberIds);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'memberIds', 'createdBy', 'createdAt', 'profile'
        ])
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && isProfile(request.resource.data.profile);
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile'])
        && isProfile(request.resource.data.profile);
      allow delete: if false;

      match /stock/{itemId} {
        allow read, delete: if isMember(householdId);
        allow create: if isMember(householdId)
          && isStockItem(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isMember(householdId)
          && isStockItem(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }
  }
}
