rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function isMember(householdId) {
      return signedIn()
        && exists(householdPath(householdId))
        && request.auth.uid in get(householdPath(householdId)).data.memberIds;
    }

    function isMemberAfterWrite(householdId) {
      return signedIn()
        && existsAfter(householdPath(householdId))
        && request.auth.uid in getAfter(householdPath(householdId)).data.memberIds;
    }

    function isWordList(value) {
      return value is list && value.size() <= 50;
    }

    function isCount(value, minimum, maximum) {
      return value is int && value >= minimum && value <= maximum;
    }

    function isLocation(location) {
      return location == null || (
        location is map
        && location.keys().hasOnly(['postalCode', 'city'])
        && location.postalCode is string
        && location.postalCode.size() <= 10
        && location.city is string
        && location.city.size() <= 100
      );
    }

    function isProfile(profile) {
      return profile == null || (
        profile is map
        && profile.keys().hasOnly([
          'adults', 'children', 'likes', 'exclusions', 'allergies',
          'maxPrepMinutes', 'weeklyBudgetCents', 'location'
        ])
        && isCount(profile.adults, 1, 12)
        && isCount(profile.children, 0, 12)
        && isWordList(profile.likes)
        && isWordList(profile.exclusions)
        && isWordList(profile.allergies)
        && isCount(profile.maxPrepMinutes, 5, 240)
        && (profile.weeklyBudgetCents == null
          || isCount(profile.weeklyBudgetCents, 0, 10000000))
        && isLocation(profile.location)
      );
    }

    function isStockItem(item) {
      return item.keys().hasOnly([
          'name', 'quantity', 'unit', 'category', 'bestBefore', 'createdAt', 'updatedAt'
        ])
        && item.name is string
        && item.name.size() >= 1
        && item.name.size() <= 80
        && item.quantity is number
        && item.quantity > 0
        && item.quantity <= 100000
        && item.unit in ['piece', 'gram', 'kilogram', 'milliliter', 'liter', 'pack']
        && item.category in [
          'fruitsVegetables', 'meatFish', 'dairy', 'grocery', 'frozen', 'drinks', 'other'
        ]
        && (item.bestBefore == null || item.bestBefore is timestamp)
        && item.updatedAt == request.time;
    }

    function isMealIdea(idea) {
      return idea is map
        && idea.keys().hasOnly([
          'id', 'title', 'description', 'prepMinutes', 'cookMinutes', 'servings', 'kind',
          'difficulty', 'equipment', 'photo', 'ingredients', 'steps'
        ])
        && idea.title is string
        && idea.title.size() <= 80
        && idea.description is string
        && idea.description.size() <= 200
        && idea.prepMinutes is int
        && idea.cookMinutes is int
        && idea.servings is int
        && (idea.photo == null || (idea.photo is string && idea.photo.size() <= 300))
        && idea.equipment is list
        && idea.equipment.size() <= 4
        && idea.ingredients is list
        && idea.ingredients.size() >= 1
        && idea.ingredients.size() <= 20
        && idea.steps is list
        && idea.steps.size() <= 12;
    }

    function isMealPlan(plan) {
      return plan.keys().hasOnly(['craving', 'createdAt', 'ideas'])
        && plan.craving is string
        && plan.createdAt == request.time
        && plan.ideas is list
        && plan.ideas.size() >= 1
        && plan.ideas.size() <= 3
        && isMealIdea(plan.ideas[0])
        && (plan.ideas.size() < 2 || isMealIdea(plan.ideas[1]))
        && (plan.ideas.size() < 3 || isMealIdea(plan.ideas[2]));
    }

    function isWeekMeal(meal) {
      return meal.keys().hasOnly(['idea', 'status', 'addedAt'])
        && isMealIdea(meal.idea)
        && meal.status in ['planned', 'cooked']
        && meal.addedAt == request.time;
    }

    function isShoppingEntry(entry) {
      return entry.keys().hasOnly([
          'key', 'name', 'quantity', 'unit', 'category', 'checked', 'dismissed', 'manual', 'addedBy', 'updatedAt'
        ])
        && entry.key is string
        && entry.key.size() <= 200
        && entry.name is string
        && entry.name.size() >= 1
        && entry.name.size() <= 80
        && (entry.quantity == null || (entry.quantity is number && entry.quantity > 0 && entry.quantity <= 100000))
        && entry.unit in ['piece', 'gram', 'kilogram', 'milliliter', 'liter', 'pack']
        && (entry.category == null || entry.category is string)
        && entry.checked is bool
        && entry.dismissed is bool
        && entry.manual is bool
        && (entry.addedBy == null || (entry.addedBy is string && entry.addedBy.size() <= 80))
        && entry.updatedAt == request.time;
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    function joinsWithInvite(householdId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'lastInvite'])
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.lastInvite is string
        && get(invitePath(request.resource.data.lastInvite)).data.householdId == householdId
        && getAfter(invitePath(request.resource.data.lastInvite)).data.usedBy == request.auth.uid;
    }

    function leaves() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in request.resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && resource.data.memberIds.hasAll(request.resource.data.memberIds);
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['householdId', 'createdBy', 'createdAt', 'expiresAt', 'usedBy'])
        && request.resource.data.householdId is string
        && isMember(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(49, 'h')
        && request.resource.data.usedBy == null;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.usedBy == request.auth.uid
        && request.auth.uid in getAfter(householdPath(resource.data.householdId)).data.memberIds;
      allow delete: if isMember(resource.data.householdId);
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['householdId'])
        && request.resource.data.householdId is string
        && isMemberAfterWrite(request.resource.data.householdId);
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == userId
        && (!existsAfter(householdPath(resource.data.householdId))
          || !(request.auth.uid in getAfter(householdPath(resource.data.householdId)).data.memberIds));
    }

    match /households/{householdId} {
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.memberIds);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'memberIds', 'createdBy', 'createdAt', 'profile'
        ])
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && isProfile(request.resource.data.profile);
      allow update: if signedIn()
        && ((request.auth.uid in resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile'])
            && isProfile(request.resource.data.profile))
          || joinsWithInvite(householdId)
          || leaves());
      allow delete: if false;

      match /stock/{itemId} {
        allow read, delete: if isMember(householdId);
        allow create: if isMember(householdId)
          && isStockItem(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isMember(householdId)
          && isStockItem(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /members/{memberId} {
        allow read: if isMember(householdId);
        allow create, update: if signedIn()
          && request.auth.uid == memberId
          && isMemberAfterWrite(householdId)
          && request.resource.data.keys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 80;
        allow delete: if signedIn() && request.auth.uid == memberId;
      }

      match /mealPlans/{planId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId)
          && planId == 'current'
          && isMealPlan(request.resource.data);
        allow delete: if false;
      }

      match /weekMeals/{mealId} {
        allow read, delete: if isMember(householdId);
        allow create: if isMember(householdId) && isWeekMeal(request.resource.data);
        allow update: if isMember(householdId)
          && (isWeekMeal(request.resource.data)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status in ['planned', 'cooked']));
      }

      match /shopping/{entryId} {
        allow read, delete: if isMember(householdId);
        allow create, update: if isMember(householdId) && isShoppingEntry(request.resource.data);
      }

      match /cookedMeals/{mealId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId)
          && request.resource.data.keys().hasOnly(['title', 'cookedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 80
          && request.resource.data.cookedAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
